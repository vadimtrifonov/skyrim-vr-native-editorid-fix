root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{h,hpp,cpp,cxx,ixx}]
indent_style = tab
indent_size = 4

[*.lua]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.{md,txt,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
